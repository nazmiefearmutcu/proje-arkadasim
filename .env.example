# Proje Arkadaşım ortam değişkenleri şablonu.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.

# SQLite veritabanı dosyasının yolu (prisma/ klasörüne göre değil, proje köküne göre).
DATABASE_URL="file:./dev.db"

# Oturum imzası için gizli anahtar. En az 32 bayt rastgele hex değer kullanın.
SESSION_SECRET=""

# Belge özetlerini (HMAC) üretirken kullanılan gizli biber. Değişirse eski özetler eşleşmez.
DOC_HASH_PEPPER=""

# Belge doğrulayıcı sağlayıcısı. Geliştirmede "mock" kullanın; gerçek AI için "deepseek".
VERIFIER_PROVIDER="mock"

# DeepSeek API anahtarı. Boş bırakılırsa AI doğrulaması kullanılmaz.
DEEPSEEK_API_KEY=""

# DeepSeek model adı.
DEEPSEEK_MODEL="deepseek-flash"

# DeepSeek API uç noktası (OpenAI uyumlu).
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Uygulamanın dışarıdan erişilen kök adresi (bağlantılar ve e-posta metinleri için).
APP_URL="http://localhost:3000"

# SMTP bağlantı adresi (ör. smtp://kullanici:parola@sunucu:587). Boşsa e-postalar yalnız konsola yazılır.
SMTP_URL=""

# Giden e-postalarda görünen gönderen adresi.
MAIL_FROM="Proje Arkadaşım <no-reply@proje-arkadasim.local>"

# Giriş kayıtlarının (IP, zaman, tarayıcı) saklanma süresi, gün cinsinden.
LOGIN_LOG_RETENTION_DAYS="365"

# Yönetici e-postaları, virgülle ayrılmış. Çalışma zamanında yetki VERMEZ (kayıtta e-posta
# sahipliği doğrulanmadığı için). Yalnız tohum/operatör işlemi bu listeyi okuyup role ADMIN atar.
ADMIN_EMAILS=""

# Uygulama güvenilir bir ters vekilin (reverse proxy) arkasındaysa "true" yapın. Yalnız o zaman
# x-forwarded-for / x-real-ip okunur; aksi halde hız sınırı tüm istekleri tek kovada sayar.
TRUST_PROXY="false"

# Tohum (seed) verisindeki yönetici hesabının e-postası ve parolası (yalnız geliştirme).
SEED_ADMIN_EMAIL="admin@proje-arkadasim.local"
SEED_ADMIN_PASSWORD="Yonetici-Dev-2026!"

# Tohum verisindeki örnek kullanıcıların ortak parolası (yalnız geliştirme).
SEED_USER_PASSWORD="Ogrenci-Dev-2026!"
