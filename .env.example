# Proje Arkadaşım ortam değişkenleri şablonu.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.
# Başında "#" olan değişkenler isteğe bağlıdır; varsayılan yetmezse "#" işaretini kaldırıp doldurun.

# SQLite veritabanı dosyasının yolu. Göreli yol prisma/schema.prisma'nın bulunduğu prisma/ klasörüne göre çözülür (dosya: prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Belge özetlerini (HMAC) üretirken kullanılan gizli biber. En az 32 bayt rastgele hex değer kullanın.
# Tanımlı değilse belge yükleme hata verir. Değişirse eski özetler eşleşmez.
DOC_HASH_PEPPER=""

# Belge doğrulayıcı sağlayıcısı. Geliştirmede "mock" kullanın; gerçek AI için "openai" (varsayılan) ya da "deepseek".
# Üretimde "mock" kullanılamaz.
VERIFIER_PROVIDER="mock"

# OpenAI API anahtarı. Boş bırakılırsa AI doğrulaması kullanılmaz; belgeler manuel incelemeye düşer.
OPENAI_API_KEY=""

# OpenAI model adı ve akıl yürütme düzeyi (minimal, low, medium, high).
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_REASONING_EFFORT="low"

# İsteğe bağlı: DeepSeek (Çin). Seçilirse src/config/legal.ts içindeki AI_PROVIDER ve rıza metni de değişmeli.
# DeepSeek API anahtarı.
DEEPSEEK_API_KEY=""

# DeepSeek model adı.
DEEPSEEK_MODEL="deepseek-flash"

# DeepSeek API uç noktası (OpenAI uyumlu).
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# "enabled" ya da "disabled" değerleriyle DeepSeek'in düşünme modunu açıp kapatır. Boşsa istekte gönderilmez.
# DEEPSEEK_THINKING=""

# Uygulamanın dışarıdan erişilen kök adresi (ör. https://proje-arkadasim.com.tr). Şifre sıfırlama
# bağlantıları yalnız bu değerden kurulur; istek başlıklarından (Host) türetilmez. Üretimde zorunludur:
# NODE_ENV=production iken boşsa sıfırlama bağlantısı gönderilmez ve sunucu günlüğüne bir uyarı yazılır.
# Geliştirmede boş bırakılabilir; o zaman http://localhost:3000 kullanılır. Örnek değer bilerek boştur:
# üretime kopyalanan bir localhost adresi kullanılamaz bağlantılar üretirdi.
APP_URL=""

# SMTP bağlantı adresi (ör. smtp://kullanici:parola@sunucu:587). Üretimde zorunludur.
# Geliştirmede boşsa e-postalar konsola yazılır: gövde gizlenir, şifre sıfırlama bağlantısı ise yerelde
# denenebilsin diye ayrı bir "Geliştirme bağlantısı" satırında tam yazılır.
SMTP_URL=""

# Giden e-postalarda görünen gönderen adresi.
MAIL_FROM="Proje Arkadaşım <no-reply@proje-arkadasim.local>"

# Giriş kayıtlarının (IP, zaman, tarayıcı) saklanma süresi, gün cinsinden.
LOGIN_LOG_RETENTION_DAYS="365"

# Uygulama güvenilir bir ters vekilin (reverse proxy) arkasındaysa "true" yapın. Yalnız o zaman
# x-forwarded-for / x-real-ip okunur. "false" iken istemci IP'si bilinmez ("local"): giriş sınırı
# yine IP + e-posta anahtarıyla uygulanır, ama kayıt (5/saat) gibi yalnız IP'ye bağlı sınırlar
# tüm site için ortak bir kovaya düşer. Ters vekil arkasında mutlaka "true" yapın.
TRUST_PROXY="false"

# Profil resimlerinin klasörü. Varsayılan storage/avatars (uygulamanın çalıştığı klasöre göre).
# Üretimde kalıcı bir diskte olmalıdır; geçici dosya sisteminde yeniden başlatmada resimler kaybolur.
# AVATAR_DIR=""

# Fotoğraf OCR'ı için tesseract dil verisinin (tur ve eng traineddata) tutulduğu klasör. Varsayılan
# storage/tessdata. Dosyalar yoksa ilk fotoğraf yüklemesinde cdn.jsdelivr.net'ten bir kez indirilir.
# Sunucunun dışarıya HTTP erişimi yoksa tur.traineddata ve eng.traineddata dosyalarını bu klasöre önceden koyun.
# TESSDATA_LANG_PATH=""

# Tohum (seed) yalnız geliştirme içindir: önce TÜM tabloları siler, sonra demo verisini (örnek hesaplar,
# projeler, mesajlar) yükler. Veritabanında kullanıcı varsa yalnız "npm run seed -- --wipe" ile çalışır.
# Üretimde yönetici atamak için tohum değil, "npm run make-admin -- <e-posta>" kullanılır (var olan
# hesabı yönetici yapar, veri silmez). Aşağıdaki parolalar herkese açıktır; üretimde reddedilir.
SEED_ADMIN_EMAIL="admin@proje-arkadasim.local"
SEED_ADMIN_PASSWORD="Yonetici-Dev-2026!"

# Tohum verisindeki örnek kullanıcıların ortak parolası (yalnız geliştirme).
SEED_USER_PASSWORD="Ogrenci-Dev-2026!"

# "true" değilse tohum NODE_ENV=production iken hiç çalışmaz. Üretim veritabanında tohum çalıştırmayın:
# tüm gerçek veriyi siler. Yalnız boş bir hazırlık (staging) veritabanına bilerek demo verisi yüklemek için.
# SEED_ALLOW_PRODUCTION="false"
